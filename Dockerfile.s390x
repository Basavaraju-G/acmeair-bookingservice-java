## Stage 1: Build with Java 11 (maven-war-plugin default v2.2 is broken on Java 16+)
FROM --platform=linux/s390x eclipse-temurin:11-jdk AS builder

WORKDIR /build

COPY pom.xml mvnw ./
COPY .mvn .mvn
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B || true

COPY src src

# Skip tests: de.flapdoodle.embed.mongo lacks s390x binaries
RUN ./mvnw package -DskipTests -B

## Stage 2: Runtime with Java 17 (required by MicroProfile 7.1)
FROM --platform=linux/s390x icr.io/appcafe/open-liberty:full-java17-openj9-ubi

# Config
COPY --chown=1001:0 src/main/liberty/config/server.xml /config/server.xml
COPY --chown=1001:0 src/main/liberty/config/jvm.options /config/jvm.options
COPY --chown=1001:0 src/main/liberty/config/bootstrap.properties /config/bootstrap.properties

# App - use wildcard to avoid hardcoding artifact name
COPY --chown=1001:0 --from=builder /build/target/*.war /config/apps/

# Logging vars
ENV LOGGING_FORMAT=simple
ENV ACCESS_LOGGING_ENABLED=false
ENV TRACE_SPEC=*=info

# Build SCC
ARG CREATE_OPENJ9_SCC=true
ENV OPENJ9_SCC=${CREATE_OPENJ9_SCC}

RUN configure.sh
